# Caspian source files: Ruby is the closest existing Linguist language.
# Caspian's style is Ruby-influenced, so most syntax highlights cleanly
# (sigils like $foo and %sys won't be perfect; everything else mostly works).
# Replace with `linguist-language=Caspian` if/when Caspian lands in
# github-linguist proper.
*.casp linguist-language=Ruby

# CaspianJ files: JSON-shaped. Linguist would otherwise detect .caspj as
# something else, which is wrong for this project.
*.caspj linguist-language=JSON
