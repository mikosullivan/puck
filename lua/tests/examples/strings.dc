$a = 'single quoted — no interpolation'
$b = "double quoted — $a is interpolated"
$c = "expression: #{1 + 2}"
$d = :colon_shorthand
$e = 'colon_shorthand'

$heredoc_raw = <<'EOF'
    This is not interpolated.
    $name stays as-is.
EOF

$heredoc_plain = <<EOF
    Also not interpolated.
EOF

$name = 'Picard'

$heredoc_interpolated = <<"EOF"
    Hello, $name.
    Rank: #{$name.rank}
EOF

$match = $name.match('%a+')
puts($match.text)
puts($match.start)
puts($match.end)

if ($name.match?('%u%l+'))
    puts('starts with capital')
end

$safe = $name&.upcase
$chained = $name.match('%a+')&.text
