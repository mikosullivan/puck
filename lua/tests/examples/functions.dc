function &greet($name, $rank)
    'Hello, ' + rank + ' ' + name
end

puts &greet(name: 'Picard', rank: 'Captain')

function &apply($value)
    yield value
end

&apply(value: 42) do($v)
    puts $v
end

$double = function($n)
    $n * 2
end

puts &double(21)

function &build_report
    $result = %call.dispatcher

    yield %blocks[0]
    yield %blocks[1]
    yield %blocks[2]
end

&build_report do($section)
    puts($section)
end

$adder = &greet.caller
$adder.rank = 'Admiral'
$adder.name = 'Janeway'
$adder.call

$validate = function($record)
    return $record['name'] == null
end

$var = $$validate
