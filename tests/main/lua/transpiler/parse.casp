	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"sp": {
						"l": 1,
						"var": "args"
					}
				}
			],
			"fn": "run",
			"kw": [
				{
					"kwsplat": {
						"l": 1,
						"var": "opts"
					}
				}
			],
			"rc": {
				"var": "obj"
			}
		}
