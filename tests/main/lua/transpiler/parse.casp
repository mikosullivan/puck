#
# name: method call with a variable-arg
#====================================================================


#====================================================================
# name: method call with mixed literal / array / hash args
#

#--- code -----------------------------------------------------------
$obj.method('a', [1, 2], {k: 1})
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"var": "obj"
		},
		"method",
		{
			"args": [
				{
					"line": 1,
					"value": "a"
				},
				{
					"array": [
						{
							"line": 1,
							"value": 1
						},
						{
							"line": 1,
							"value": 2
						}
					],
					"line": 1
				},
				{
					"hash": [
						[
							"k",
							{
								"line": 1,
								"value": 1
							}
						]
					],
					"line": 1
				}
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 1,
					"v": "a"
				},
				{
					"ar": [
						{
							"l": 1,
							"v": 1
						},
						{
							"l": 1,
							"v": 2
						}
					],
					"l": 1
				},
				{
					"hash": [
						[
							"k",
							{
								"l": 1,
								"v": 1
							}
						]
					],
					"l": 1
				}
			],
			"fn": "method",
			"rc": {
				"var": "obj"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: method call with mixed literal / array / hash args
#====================================================================


#====================================================================
# name: method call as RHS of an assignment
#

#--- code -----------------------------------------------------------
$result = $obj.method_name(1, 2)
