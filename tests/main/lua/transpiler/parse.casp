#
# name: begin with as $block controller
#====================================================================


#====================================================================
# name: begin with ensure clause
# `ensure` runs on all exit paths — clause slot added on demand (not in the default 5-clause set) so an atom without a declared `ensure` doesn't carry an empty slot
#

#--- code -----------------------------------------------------------
begin
	puts 'in body'
ensure
	puts 'always runs'
end
#--------------------------------------------------------------------

