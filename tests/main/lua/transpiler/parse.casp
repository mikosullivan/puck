	[
		{
			"in": "as"
		},
		"item",
		[
			{
				"in": "fc"
			},
			{
				"a": [
					{
						"l": 1,
						"v": "a"
					}
				],
				"fn": "[]",
				"l": 1,
				"rc": {
					"l": 1,
					"var": "hash"
				}
			}
		]
	]
]
