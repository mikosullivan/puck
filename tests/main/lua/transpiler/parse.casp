#--------------------------------------------------------------------

#
# name: long-form closure assignment
# `$name = closure(...) end`
#====================================================================


# design decisions for Section 11 (functions, closures, methods):
#
#   Two orthogonal axes to preserve in CaspJ:
#
#   1. Which SYNTACTIC FORM the developer used (setvar-verb):
#        setvar   — long form:  `$foo = function(...) ... end`
#        def      — sugar form: `function &foo(...) ... end`
#      Both do the same thing (create a callable, bind it to the variable);
#      CaspJ preserves which form was written.
#
#   2. Which KIND of callable was created (value-atom key):
#        {function: {params, body}}  — plain function (no scope capture)
#        {closure:  {params, body}}  — closure (captures the enclosing scope)
#        {method:   {params, body}}  — method (only ever appears via the def
#                                       verb; there is no long-form
#                                       `$foo = method(...)`)
#
#   Combined shape:  ["scope", <verb>, <name>, {<kind>: {params, body}}]
#
#   Params in V1: a list where each entry is either a plain string (bare
#   param name, no metadata) or an object `{name: "x", meta: [[k, v], ...]}`
#   (param with rich metadata). The `$` sigil is a use-site concern and
#   isn't stored on the param entry.
#
#   Rich metadata syntax: `$name: {class: :string, default: 5, ...}` — colon
#   after the param name, then a hash literal. Values in the metadata hash
#   are parsed as value-atoms; the runtime interprets them at call time
#   (`default:` re-runs per call, per parameter-defaults rule; `class:` is
#   a constant type constraint). `meta` is a list of `[key, value_atom]`
#   pairs — same shape convention as call-site `kw` and heredoc paren-block
#   kwargs.
#
#   Splat params: `*$args` (positional collector) and `**$opts` (kwargs
#   collector) at the param declaration site. Shape mirrors the rich-
#   metadata form with a `splat: true` or `kwsplat: true` flag:
#     *$args         -> {name: "args", splat: true}
#     **$opts        -> {name: "opts", kwsplat: true}
#     *$args: {...}  -> {name: "args", splat: true, meta: [...]}
#   Semantically the DECLARATION-side inverse of the call-site splat atoms
#   from Section 12 — declaration collects, call spreads.
#
# The composite `$rich_params = function(...) end` example that exercises every
# rich-param feature (metadata + splat + kwsplat + long-form assignment) is
# now a fixture above; the survey block previously here has been promoted.

#====================================================================
# Call sites
#====================================================================


#====================================================================
# name: method call with a single string arg (parens form)
#

#--- code -----------------------------------------------------------
$greet.call('alice')
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"var": "greet"
		},
		"call",
		{
			"args": [
				{
					"line": 1,
					"value": "alice"
				}
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 1,
					"v": "alice"
				}
			],
			"fn": "call",
			"rc": {
				"var": "greet"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: method call with a single string arg (parens form)
#====================================================================


#====================================================================
# name: method call with two numeric args (parens form)
#

#--- code -----------------------------------------------------------
$obj.method_name(1, 2)
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"var": "obj"
		},
		"method_name",
		{
			"args": [
				{
					"line": 1,
					"value": 1
				},
				{
					"line": 1,
					"value": 2
				}
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 1,
					"v": 1
				},
				{
					"l": 1,
					"v": 2
				}
			],
			"fn": "method_name",
			"rc": {
				"var": "obj"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: method call with two numeric args (parens form)
#====================================================================


#====================================================================
# name: method call with two numeric args (paren-less form)
#

#--- code -----------------------------------------------------------
$obj.method_name 1, 2
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"var": "obj"
		},
		"method_name",
		{
			"args": [
				{
					"line": 1,
					"value": 1
				},
				{
					"line": 1,
					"value": 2
				}
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 1,
					"v": 1
				},
				{
					"l": 1,
					"v": 2
				}
			],
			"fn": "method_name",
			"rc": {
				"var": "obj"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: method call with two numeric args (paren-less form)
#====================================================================


#====================================================================
# name: paren-less method call inside `&(EXPR)` pipe RHS
# `$bar.call 'whatever'` inside the inner pipe parses the same as
# `$bar.call('whatever')` — the paren-less method-call form is allowed at
# expression position, matching the paren form byte-for-byte in full CaspJ
# (aside from the source line each fixture row lands on).
#

#--- code -----------------------------------------------------------
&($bar.call 'whatever' | &blah)
&($bar.call('whatever') | &blah)
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"amp": {
				"left": [
					{
						"line": 1,
						"var": "bar"
					},
					"call",
					{
						"args": [
							{
								"line": 1,
								"value": "whatever"
							}
						],
						"line": 1
					}
				],
				"op": "|",
				"right": [
					{
						"amp": "blah"
					}
				]
			},
			"line": 1
		}
	],
	[
		{
			"amp": {
				"left": [
					{
						"line": 2,
						"var": "bar"
					},
					"call",
					{
						"args": [
							{
								"line": 2,
								"value": "whatever"
							}
						],
						"line": 2
					}
				],
				"op": "|",
				"right": [
					{
						"amp": "blah"
					}
				]
			},
			"line": 2
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"fn": "call",
			"rc": [
				{
					"in": "fc"
				},
				{
					"a": [
						[
							{
								"in": "fc"
							},
							{
								"a": [
									{
										"l": 1,
										"v": "whatever"
									}
								],
								"fn": "call",
								"l": 1,
								"rc": {
									"l": 1,
									"var": "bar"
								}
							}
						]
					],
					"fn": "call",
					"rc": {
						"var": "blah"
					}
				}
			]
		}
	],
	[
		{
			"in": "fc"
		},
		{
			"fn": "call",
			"rc": [
				{
					"in": "fc"
				},
				{
					"a": [
						[
							{
								"in": "fc"
							},
							{
								"a": [
									{
										"l": 2,
										"v": "whatever"
									}
								],
								"fn": "call",
								"l": 2,
								"rc": {
									"l": 2,
									"var": "bar"
								}
							}
						]
					],
					"fn": "call",
					"rc": {
						"var": "blah"
					}
				}
			]
		}
	]
]
#--------------------------------------------------------------------

#
# name: paren-less method call inside `&(EXPR)` pipe RHS
#====================================================================


#====================================================================
# name: two amp calls on separate lines
# The trio of contrast fixtures below shows how amp-call parsing
# disambiguates by whitespace: newline-separated is two calls, space-
# separated is one call, and trailing-comma-then-newline is one call
# continued across lines.
#

#--- code -----------------------------------------------------------
&foo
&bar
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"amp": "foo",
			"line": 1
		}
	],
	[
		{
			"amp": "bar",
			"line": 2
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"fn": "call",
			"rc": {
				"l": 1,
				"var": "foo"
			}
		}
	],
	[
		{
			"in": "fc"
		},
		{
			"fn": "call",
			"rc": {
				"l": 2,
				"var": "bar"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: two amp calls on separate lines
#====================================================================


#====================================================================
# name: amp call with paren-less amp argument
# `&foo &bar` on one line is a single amp call — `&bar` is the paren-less
# first arg to `&foo`, not a second statement. Contrast with the newline-
# separated form immediately above and the comma-continued form below.
#

#--- code -----------------------------------------------------------
&foo &bar
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"amp": "foo"
		},
		[
			{
				"amp": "bar",
				"line": 1
			}
		],
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				[
					{
						"in": "fc"
					},
					{
						"fn": "call",
						"rc": {
							"l": 1,
							"var": "bar"
						}
					}
				]
			],
			"fn": "call",
			"rc": {
				"var": "foo"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: amp call with paren-less amp argument
#====================================================================


#====================================================================
# name: trailing-comma line continuation on a paren-less amp call
# A paren-less arg list ending in `,` at end-of-line signals the statement
# continues on the next line — same rule programmers already know from most
# languages. Parses identically to writing the whole call on one line.
#

#--- code -----------------------------------------------------------
&foo 'x',
	&bar
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"amp": "foo"
		},
		{
			"line": 1,
			"value": "x"
		},
		[
			{
				"amp": "bar",
				"line": 1
			}
		],
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 1,
					"v": "x"
				},
				[
					{
						"in": "fc"
					},
					{
						"fn": "call",
						"rc": {
							"l": 1,
							"var": "bar"
						}
					}
				]
			],
			"fn": "call",
			"rc": {
				"var": "foo"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: trailing-comma line continuation on a paren-less amp call
#====================================================================


#====================================================================
# name: trailing-comma line continuation on a paren-less bareword call
# Same rule applies to bareword-command calls — `puts 'a',\n\t'b'` reads
# the same as `puts 'a', 'b'`.
#

#--- code -----------------------------------------------------------
puts 'a',
	'b',
	'c'
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"bwc": "puts"
		},
		{
			"line": 1,
			"value": "a"
		},
		{
			"line": 1,
			"value": "b"
		},
		{
			"line": 1,
			"value": "c"
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"bwc": "puts"
		},
		{
			"l": 1,
			"v": "a"
		},
		{
			"l": 1,
			"v": "b"
		},
		{
			"l": 1,
			"v": "c"
		}
	]
]
#--------------------------------------------------------------------

#
# name: trailing-comma line continuation on a paren-less bareword call
#====================================================================


#====================================================================
# name: method call with a nested expression as arg
#

#--- code -----------------------------------------------------------
$obj.method(1 + 2)
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"var": "obj"
		},
		"method",
		{
			"args": [
				{
					"left": {
						"line": 1,
						"value": 1
					},
					"line": 1,
					"op": "+",
					"right": {
						"line": 1,
						"value": 2
					}
				}
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				[
					{
						"in": "fc"
					},
					{
						"a": [
							{
								"l": 1,
								"v": 2
							}
						],
						"fn": "+",
						"rc": {
							"l": 1,
							"v": 1
						}
					}
				]
			],
			"fn": "method",
			"rc": {
				"var": "obj"
			}
		}
	]
]
#--------------------------------------------------------------------

