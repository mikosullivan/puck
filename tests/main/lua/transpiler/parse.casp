	[
		"scope",
		"setvar",
		"ternary",
		{
			"cond": {
				"left": {
					"line": 1,
					"var": "x"
				},
				"line": 1,
				"op": ">",
				"right": {
					"line": 1,
					"value": 0
				}
			},
			"else": {
				"line": 1,
				"value": "non-positive"
			},
			"line": 1,
			"op": "?:",
			"then": {
				"line": 1,
				"value": "positive"
			}
		},
		{
			"line": 1
		}
	]
]
