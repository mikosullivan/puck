					"line": 1,
					"value": "bar"
				},
				{
					"line": 1,
					"value": 2
				},
				{
					"line": 1,
					"var": "gup"
				},
				{
					"line": 1,
					"value": 42
				}
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 1,
					"v": "bar"
				},
				{
					"l": 1,
					"v": 2
				},
				{
					"l": 1,
					"var": "gup"
				},
				{
					"l": 1,
					"v": 42
				}
			],
			"fn": "[]=",
			"rc": {
				"var": "foo"
			}
		}
	]
]
