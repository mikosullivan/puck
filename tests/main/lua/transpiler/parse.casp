						"return",
						{
							"l": 2,
							"v": "match"
						}
					]
				],
				"name": "getname",
				"pm": []
			},
			"l": 3
		}
	],
	[
		[
			{
				"in": "fc"
			},
			{
				"fn": {
					"amp": "getname",
					"l": 5
				},
				"rc": {
					"l": 5,
					"var": "obj"
				}
			}
		]
	]
]
#--------------------------------------------------------------------

#
# name: object dot amp-call, no args
#====================================================================


#====================================================================
# name: object dot parenthesized expression
#

#--- code -----------------------------------------------------------
$foo.(begin as $block
	$block.return 'match'
end)
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"op": ".",
			"left": {"line": 1, "var": "foo"},
			"right": {
				"begin_end": {
					"as": "block",
					"body": [
						[
							{
								"op": ".",
								"left": {"var": "block"},
								"right": "return",
								"args": [{"line": 2, "value": "match"}],
								"line": 2
							},
							{"line": 2}
						]
					]
				}
			},
			"line": 3
		},
		{"line": 3}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		[
			{
				"in": "fc"
			},
			{
				"fn": {
					"be": {
						"as": "block",
						"bd": [
							[
								[
									{
										"in": "fc"
									},
									{
										"a": [
											{
												"l": 2,
												"v": "match"
											}
										],
										"fn": "return",
										"rc": {
											"var": "block"
										}
									}
								]
							]
						]
					}
				},
				"rc": {
					"l": 1,
					"var": "foo"
				}
			},
			{
				"l": 3
			}
		],
		{
			"l": 3
		}
	]
]
#--------------------------------------------------------------------

#
# name: object dot parenthesized expression
#====================================================================


#====================================================================
# name: amp-call receiver dot amp-call method with args
#

#--- code -----------------------------------------------------------
&get_object.&get_func('big')(true)
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"op": ".",
			"left": {"line": 1, "amp": "get_object"},
			"right": {
				"line": 1,
				"amp": "get_func",
				"args": [{"line": 1, "value": "big"}]
			},
			"args": [{"line": 1, "value": true}],
			"line": 1
		},
		{"line": 1}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		[
			{
				"in": "fc"
			},
			{
				"a": [
					{
						"l": 1,
						"v": true
					}
				],
				"fn": {
					"a": [
						{
							"l": 1,
							"v": "big"
						}
					],
					"amp": "get_func",
					"l": 1
				},
				"rc": {
					"amp": "get_object",
					"l": 1
				}
			}
		]
	]
]
#--------------------------------------------------------------------

#
# name: amp-call receiver dot amp-call method with args
#====================================================================


#====================================================================
# name: object dot keyword as method name
# `$foo.if` — `if` is a keyword elsewhere, but in method position after
# a dot it's just a bareword method name (a string). Same shape as any
# other bareword method call; the parser treats whatever's after the
# dot as a method-name identifier, keyword-ness irrelevant.
#

#--- code -----------------------------------------------------------
$foo.if
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"op": ".",
			"left": {"line": 1, "var": "foo"},
			"right": "if",
			"line": 1
		},
		{"line": 1}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		[
			{
				"in": "fc"
			},
			{
				"fn": "if",
				"rc": {
					"l": 1,
					"var": "foo"
				}
			}
		]
	]
]
#--------------------------------------------------------------------

#
# name: object dot keyword as method name
#====================================================================


#====================================================================
# name: postfix bump on hash subscript
# `$hsh['a']++` — bumps work on subscript lvalues, not only plain
# variables. The `operand` slot on the bump op atom accepts any lvalue
# expression the normalizer can resolve to a settable location: a
# variable (varobj), a subscript, or (future) an attribute.
#

#--- code -----------------------------------------------------------
$hsh = {a: 1}
$hsh['a']++
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"hsh",
		{
			"hash": [
				["a", {"line": 1, "value": 1}]
			],
			"line": 1
		},
		{"line": 1}
	],
	[
		{
			"op": "++_suffix",
			"operand": [
				{"var": "hsh"},
				"[]",
				{"args": [{"line": 2, "value": "a"}]}
			]
		},
		{"line": 2}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"hsh",
		{
			"hash": [
				[
					"a",
					{
						"l": 1,
						"v": 1
					}
				]
			],
			"l": 1
		}
	],
	[
		[
			{
				"in": "si"
			},
			{
				"sub": {
					"k": {
						"l": 2,
						"v": "a"
					},
					"rc": {
						"var": "hsh"
					}
				}
			}
		]
	]
]
#--------------------------------------------------------------------

#
# name: postfix bump on hash subscript
#====================================================================


#====================================================================
# name: caller DSL setup and invoke
# Exercises the caller-DSL pattern (functions/caller/dsl) end to end:
# a function containing a bare bwc (`foo`); a caller built from it; a
# .dsl call wiring the bwc to a receiver; and a .call invocation. The
# CaspM shows the bwc `foo` staying as {bwc: "foo"} in the function
# body (engine resolves at runtime via the active DSL), the assign bwc
# for the two setvar statements, and function_call bwcs for the three
# method calls (.new, .caller, .dsl, .call).
#

#--- code -----------------------------------------------------------
$fn = function()
	foo
end

$caller = $fn.caller.new
$caller.dsl $bar, 'foo'
$caller.call
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"fn",
		{
			"function": {
				"body": [
					[{"bwc": "foo"}, {"line": 2}]
				],
				"params": []
			},
			"line": 3
		},
		{"line": 3}
	],
	[
		"scope",
		"setvar",
		"caller",
		{
			"op": ".",
			"left": {
				"op": ".",
				"left": {"var": "fn"},
				"right": "caller"
			},
			"right": "new",
			"line": 5
		},
		{"line": 5}
	],
	[
		{
			"op": ".",
			"left": {"var": "caller"},
			"right": "dsl",
			"args": [{"var": "bar"}, {"value": "foo"}],
			"line": 6
		},
		{"line": 6}
	],
	[
		{
			"op": ".",
			"left": {"var": "caller"},
			"right": "call",
			"line": 7
		},
		{"line": 7}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"fn",
		{
			"fn": {
				"bd": [
					[
						{
							"bwc": "foo"
						}
					]
				],
				"pm": []
			},
			"l": 3
		}
	],
	[
		{
			"in": "as"
		},
		"caller",
		[
			{
				"in": "fc"
			},
			{
				"fn": "new",
				"rc": [
					{
						"in": "fc"
					},
					{
						"fn": "caller",
						"rc": {
							"var": "fn"
						}
					}
				]
			}
		]
	],
	[
		[
			{
				"in": "fc"
			},
			{
				"a": [
					{
						"var": "bar"
					},
					{
						"v": "foo"
					}
				],
				"fn": "dsl",
				"rc": {
					"var": "caller"
				}
			}
		]
	],
	[
		[
			{
				"in": "fc"
			},
			{
				"fn": "call",
				"rc": {
					"var": "caller"
				}
			}
		]
	]
]
#--------------------------------------------------------------------

#
# name: caller DSL setup and invoke
#====================================================================


#====================================================================
# name: binary method-op with variables — `$foo + $bar`
# `+` is a method — CaspM collapses `{op:"+", left, right}` to a
# function_call with `receiver: $foo, function: "+", args: [$bar]`.
# Same rule for `-`, `*`, `/`, `%`, `**`, `==`, `!=`, `<`, `<=`, `>`,
# `>=`, `<=>`. Contrast with genuine non-method operators (`||`, `&&`,
# `|`, `|&`, `!`) which stay as op atoms.
#

#--- code -----------------------------------------------------------
$x = $foo + $bar
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"x",
		{
			"left": {
				"line": 1,
				"var": "foo"
			},
			"line": 1,
			"op": "+",
			"right": {
				"line": 1,
				"var": "bar"
			}
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"x",
		[
			{
				"in": "fc"
			},
			{
				"a": [
					{
						"l": 1,
						"var": "bar"
					}
				],
				"fn": "+",
				"rc": {
					"l": 1,
					"var": "foo"
				}
			}
		]
	]
]
#--------------------------------------------------------------------

#
# name: binary method-op with variables — `$foo + $bar`
#====================================================================


#====================================================================
# name: paren-less dot method call with one arg — `$foo.zap $bar`
# Paren-less method call at statement position — the row shape `[recv,
# method_name, {args: [...]}]` in CaspJ collapses to a function_call
# in CaspM (same envelope shape whether the source used parens or not).
#

#--- code -----------------------------------------------------------
$foo.zap $bar
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"var": "foo"
		},
		"zap",
		{
			"args": [
				{
					"line": 1,
					"var": "bar"
				}
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 1,
					"var": "bar"
				}
			],
			"fn": "zap",
			"rc": {
				"var": "foo"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: paren-less dot method call with one arg — `$foo.zap $bar`
#====================================================================


#====================================================================
# name: non-method binary operator — `$foo || $bar`
# `||` is a genuine binary operator (short-circuit boolean OR), NOT a
# method — CaspM keeps the op atom shape unchanged. Same rule for
# `&&`, `|` (pipe), `|&` (null-safe pipe), `!` (unary not). The engine
# dispatches these on `op:` directly, no method-name lookup.
#

#--- code -----------------------------------------------------------
$x = $foo || $bar
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"x",
		{
			"left": {
				"line": 1,
				"var": "foo"
			},
			"op": "||",
			"right": {
				"line": 1,
				"var": "bar"
			}
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"x",
		{
			"left": {
				"l": 1,
				"var": "foo"
			},
			"op": "||",
			"right": {
				"l": 1,
				"var": "bar"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: non-method binary operator — `$foo || $bar`
#====================================================================