[
	[
		{
			"in": "as"
		},
		"ternary",
		{
			"if": {
				"conditions": [
					{
						"action": [
							{
								"l": 1,
								"v": "positive"
							}
						],
						"test": [
							{
								"in": "fc"
							},
							{
								"a": [
									{
										"l": 1,
										"v": 0
									}
								],
								"fn": ">",
								"rc": {
									"l": 1,
									"var": "x"
								}
							}
						]
					}
				],
				"else": [
					{
						"l": 1,
						"v": "non-positive"
					}
				]
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: ternary conditional
#====================================================================


# design decisions made unilaterally for Section 7:
#
#   - binary op:   {op: "<op>", left: L, right: R}
#   - unary op:    {op: "not"|"!", operand: E}
#   - ternary:     {op: "?:", cond: C, "then": T, "else": F}
#
# all three share the top-level "op" key, so a runtime dispatcher can key off it
# without pattern-matching on shape. distinct from method-call shape
# ({var: X}, "method"], ...) because those are lists; operator expressions are dicts.
#
# known limitations, deferred:
#
#   - precedence and associativity for multi-op expressions. currently the parser
#     splits at the LEFTMOST top-level occurrence, which is right-associative for
#     the outer op. multi-op tests aren't in the fixture yet, so this hasn't been
#     forced into a decision.
#
#   - inline `and`/`or` require SURROUNDING SPACES to split. word ops without spaces
#     are treated as identifier characters. no test for word-op-without-space yet.

#====================================================================
# if / elsif / else / unless
#====================================================================


#====================================================================
# name: if / elsif / elseif / else chain (with `and` binop in one branch cond)
#

#--- code -----------------------------------------------------------
if $whole < 13
	&label 'child'
elsif $whole < 20
	&label 'teen'
elseif $whole >= 18 and $whole < 30
	&label 'twentysomething'
else
	&label 'adult'
end
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"if_end",
		{
			"branches": [
				{
					"body": {
						"closure": {
							"body": [
								[
									{
										"amp": "label"
									},
									{
										"line": 2,
										"value": "child"
									},
									{
										"line": 2
									}
								]
							],
							"params": []
						}
					},
					"cond": {
						"left": {
							"line": 1,
							"var": "whole"
						},
						"line": 1,
						"op": "<",
						"right": {
							"line": 1,
							"value": 13
						}
					}
				},
				{
					"body": {
						"closure": {
							"body": [
								[
									{
										"amp": "label"
									},
									{
										"line": 4,
										"value": "teen"
									},
									{
										"line": 4
									}
								]
							],
							"params": []
						}
					},
					"cond": {
						"left": {
							"line": 3,
							"var": "whole"
						},
						"line": 3,
						"op": "<",
						"right": {
							"line": 3,
							"value": 20
						}
					}
				},
				{
					"body": {
						"closure": {
							"body": [
								[
									{
										"amp": "label"
									},
									{
										"line": 6,
										"value": "twentysomething"
									},
									{
										"line": 6
									}
								]
							],
							"params": []
						}
					},
					"cond": {
						"left": {
							"left": {
								"line": 5,
								"var": "whole"
							},
							"line": 5,
							"op": ">=",
							"right": {
								"line": 5,
								"value": 18
							}
						},
						"op": "and",
						"right": {
							"left": {
								"line": 5,
								"var": "whole"
							},
							"line": 5,
							"op": "<",
							"right": {
								"line": 5,
								"value": 30
							}
						}
					}
				},
				{
					"body": {
						"closure": {
							"body": [
								[
									{
										"amp": "label"
									},
									{
										"line": 8,
										"value": "adult"
									},
									{
										"line": 8
									}
								]
							],
							"params": []
						}
					},
					"cond": null
				}
			]
		},
		{
			"line": 9
		}
	]
]
