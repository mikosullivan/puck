						{
							"line": 2
						}
					]
				],
				"ensure": [
					[
						{
							"bwc": "puts"
						},
						{
							"line": 4,
							"value": "always runs"
						},
						{
							"line": 4
						}
					]
				]
			},
			"line": 5
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"be": {
				"bd": [
					[
						{
							"bwc": "puts"
						},
						{
							"l": 2,
							"v": "in body"
						}
					]
				],
				"ensure": [
					[
						{
							"bwc": "puts"
						},
						{
							"l": 4,
							"v": "always runs"
						}
					]
				]
			},
			"l": 5
		}
	]
]
#--------------------------------------------------------------------

#
# name: begin with ensure clause
#====================================================================


#====================================================================
# name: closure with all four iteration-lifecycle clauses
# The four callable-clause set (before / between / after / noloop) is
# lifted onto the closure atom as sibling fields to `body` and `params`.
# `ensure` is NOT valid here — it belongs on bare `begin ... end`. See
# the parse-negative fixture `ensure inside a callable body raises`.
#

#--- code -----------------------------------------------------------
$foo = closure($idx)
	puts $idx
before
	puts '---'
between
	puts '- - -'
after
	puts '==='
noloop
	puts '(nothing)'
end
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"foo",
		{
			"closure": {
				"after": [
					[
						{
							"bwc": "puts"
						},
						{
							"line": 8,
							"value": "==="
						},
						{
							"line": 8
						}
					]
				],
				"before": [
					[
						{
							"bwc": "puts"
						},
						{
							"line": 4,
							"value": "---"
						},
						{
							"line": 4
						}
					]
				],
				"between": [
					[
						{
							"bwc": "puts"
						},
						{
							"line": 6,
							"value": "- - -"
						},
						{
							"line": 6
						}
					]
				],
				"body": [
					[
						{
							"bwc": "puts"
						},
						{
							"line": 2,
							"var": "idx"
						},
						{
							"line": 2
						}
					]
				],
				"noloop": [
					[
						{
							"bwc": "puts"
						},
						{
							"line": 10,
							"value": "(nothing)"
						},
						{
							"line": 10
						}
					]
				],
				"params": [
					"idx"
				]
			}
		},
		{
			"line": 11
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"foo",
		{
			"cl": {
				"after": [
					[
						{
							"bwc": "puts"
						},
						{
							"l": 8,
							"v": "==="
						}
					]
				],
				"bd": [
					[
						{
							"bwc": "puts"
						},
						{
							"l": 2,
							"var": "idx"
						}
					]
				],
				"before": [
					[
						{
							"bwc": "puts"
						},
						{
							"l": 4,
							"v": "---"
						}
					]
				],
				"between": [
					[
						{
							"bwc": "puts"
						},
						{
							"l": 6,
							"v": "- - -"
						}
					]
				],
				"noloop": [
					[
						{
							"bwc": "puts"
						},
						{
							"l": 10,
							"v": "(nothing)"
						}
					]
				],
				"pm": [
					"idx"
				]
			}
		},
		{
			"l": 11
		}
	]
]
