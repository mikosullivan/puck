				"pattern": "foo|bar|baz"
			}
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"alt",
		{
			"l": 1,
			"rx": {
				"flags": "",
				"pattern": "foo|bar|baz"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: top-level alternation of literals
#====================================================================


#====================================================================
# name: empty pattern
#

#--- code -----------------------------------------------------------
$empty_rx = rx(//)
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"empty_rx",
		{
			"line": 1,
			"rx": {
				"flags": "",
				"pattern": ""
			}
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"empty_rx",
		{
			"l": 1,
			"rx": {
				"flags": "",
				"pattern": ""
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: empty pattern
#====================================================================


# design decision made unilaterally for Section 27 (regex literals):
#
#   - shape: {rx: {pattern: <string>, flags: <string>}}
#     - `pattern` is the raw text between the delimiting slashes, verbatim
#       (backslash escapes preserved as source characters, NOT decoded)
#     - `flags` is the trailing flag string ("i", "im", etc.); empty string
#       when no flags. Order preserved as written.
#   - the wrapper is spelled `rx(...)` at the call site — treated as a special
#     construct that recognizes `/…/[flags]` as a regex literal payload.
#   - **Comments are NOT allowed inside a regex literal.** A `#` between the
#     delimiting slashes is regex content (a literal `#` character), NOT a
#     Caspian comment. Caspian's `#…\n` comment syntax does not apply inside
#     `rx(/.../)`. If a regex meaningfully needs the `#` character, write it
#     literally in the pattern; the transpiler passes it through verbatim.
#   - alternative syntaxes deferred (string-based `rx('pat', 'i')`, alternate
#     delimiters, `//pat//`-style, etc.) — add tests when the surface is spec'd.
#   - a pattern containing an unescaped `/` will need an escape rule; not
#     exercised here yet.

#====================================================================
# %fetch (long form) and %(url) (short form)
#====================================================================


#====================================================================
# name: %fetch(url) long form
# subscript on the sys receiver
#

#--- code -----------------------------------------------------------
%fetch('foo.bar/gup.casp')
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"fetch": {
				"args": [
					{
						"line": 1,
						"value": "foo.bar/gup.casp"
					}
				]
			},
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"ft": {
				"a": [
					{
						"l": 1,
						"v": "foo.bar/gup.casp"
					}
				]
			},
			"l": 1
		}
	]
]
#--------------------------------------------------------------------

#
# name: %fetch(url) long form
# subscript on the sys receiver
