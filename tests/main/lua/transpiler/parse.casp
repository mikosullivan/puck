#--------------------------------------------------------------------

#
# name: bwc call with kwargs as RHS
#====================================================================


# design decisions made unilaterally for Section 12:
#
#   - method call with args: [recv_expr, method_name, {args: [arg_expr, ...]}]
#     the args wrapper is a hash rather than raw list so future metadata
#     (keyword args, splats, blocks) has room to attach. bwc-with-args
#     stays flat ([{bwc: name}, arg, ...]) for backwards compatibility
#     with the existing Section 2 shape — the two are NOT symmetric on
#     purpose. reconciling them is a Miko decision.
#
#   - the paren-less and paren-form shapes are identical. distinction
#     between them is only a parse-time concern.
#
#   - RHS method call: same shape as the statement form, but embedded
#     as the setvar value.
#
# kwargs, positional splat, and kwargs splat on & bwc calls (settled):
#
#   Kwargs on & bwc calls use the same `{kw: [[key, val_atom], ...]}` shape
#   as bareword bwc calls (Section 22). Positional args go into the top-level
#   call list; kwargs sit in a trailing `{kw}` entry. Positional-then-named
#   order is enforced — a positional after a kwarg raises.
#
#   `*expr` is a positional splat — spreads an array into positional args.
#   Shape: `{splat: expr_atom}` as an entry in the positional list.
#   Transpile-time no-op check; runtime raises if `expr` isn't an array.
#
#   `**expr` is a kwargs splat — spreads a hash into kwargs. Shape:
#   `{kwsplat: expr_atom}` as an entry in the `{kw: [...]}` list, sitting
#   alongside literal `[key, value_atom]` entries. Order preserved.
#   Runtime raises if `expr` isn't a hash.
#
#   `*` and `**` are distinct operators (not one operator dispatching by
#   type at runtime) — see functions/call § Splat expansion for the why.
#
#   bwc call as RHS expression (`$foo = &bar` / `$r = &compute(10, 20)` /
#   `$r = &fetch('x', timeout: 30)`) — settled. Bare `&bar` is a zero-args
#   call; parens required for RHS with args (paren-less form is statement-only
#   because a condition can't disambiguate `&foo &bar`). See fixtures earlier
#   in Section 12.

#====================================================================
# do / dofunc blocks, yield, multiple blocks
#====================================================================


#====================================================================
# name: bwc call with a single do block
#

#--- code -----------------------------------------------------------
&some_method do
	%call.return $outer
end
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"amp": "some_method",
			"line": 1
		},
		{
			"blocks": [
				{
					"closure": {
						"body": [
							[
								{
									"sys": "call"
								},
								"return",
								{
									"args": [
										{
											"line": 2,
											"var": "outer"
										}
									]
								},
								{
									"line": 2
								}
							]
						],
						"params": []
					}
				}
			]
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"b": [
						{
							"closure": {
								"bd": [
									[
										{
											"in": "fc"
										},
										{
											"a": [
												{
													"l": 2,
													"var": "outer"
												}
											],
											"fn": "return",
											"rc": {
												"sys": "call"
											}
										}
									]
								],
								"pm": []
							}
						}
					]
				}
			],
			"fn": "call",
			"rc": {
				"l": 1,
				"var": "some_method"
			}
		}
	]
]
