	[
		{
			"var": "obj"
		},
		"fetch",
		{
			"args": [
				{
					"line": 1,
					"value": "https://x"
				}
			],
			"kw": [
				[
					"timeout",
					{
						"line": 1,
						"value": 30
					}
				]
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 1,
					"v": "https://x"
				}
			],
			"fn": "fetch",
			"kw": [
				[
					"timeout",
					{
						"l": 1,
						"v": 30
					}
				]
			],
			"rc": {
				"var": "obj"
			}
		}
	]
]
