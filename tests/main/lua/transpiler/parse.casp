#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"result",
		[
			{
				"line": 1,
				"var": "obj"
			},
			"method_name",
			{
				"args": [
					{
						"line": 1,
						"value": 1
					},
					{
						"line": 1,
						"value": 2
					}
				],
				"line": 1
			}
		],
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"result",
		[
			{
				"in": "fc"
			},
			{
				"a": [
					{
						"l": 1,
						"v": 1
					},
					{
						"l": 1,
						"v": 2
					}
				],
				"fn": "method_name",
				"l": 1,
				"rc": {
					"l": 1,
					"var": "obj"
				}
			}
		]
	]
]
