#--- full -----------------------------------------------------------
[
	[
		{
			"fetch": {
				"args": [
					{
						"line": 1,
						"value": "foo.bar/gup.casp"
					}
				]
			},
			"line": 1
		},
		"new",
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"fn": "new",
			"rc": {
				"ft": {
					"a": [
						{
							"l": 1,
							"v": "foo.bar/gup.casp"
						}
					]
				},
				"l": 1
			}
		}
	]
]
