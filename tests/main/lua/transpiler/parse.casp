[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 1,
					"v": "key"
				},
				{
					"l": 1,
					"v": "value"
				}
			],
			"fn": "[]=",
			"rc": {
				"var": "hash"
			}
		}
	]
]
