#
# name: pipe expression inside a method-call arg
# preserved as `{op: "|", left, right}` atom
#====================================================================


# design notes for Section 17 (pipes):
#
#   Statement-leading pipe (`| bwc [args]`) is a POST-STATEMENT MODIFIER.
#   It rewrites the immediately-preceding non-comment statement in the
#   current scope by wrapping its value in a bwc call.
#
#   Shape: `[{bwc: "modifier"}, <prev_value>, <extra_args>...]`
#
#   `end | modifier` and `| modifier` (on the next line) and `end\n\n| modifier`
#   (with a blank line between) all produce identical CaspJ — whitespace and
#   newlines around the pipe are not significant.
#
#   Chained pipes wrap outward:
#     value
#     | a
#     | b
#     -> [{bwc: "b"}, [{bwc: "a"}, value]]
#
#   Comments between the value and the pipe are skipped when finding the
#   target statement; the pipe still rewrites the value, not the comment.
#
# survey material below: expression-position pipes (`$value = LHS | stage | ...`)
# are the more classical pipe form and haven't been designed yet. They need
# bwc-as-expression semantics, decisions about `.method` receiver-only stages,
# and the `|&` sticky-null-propagation variant. Deferred.

# basic — first-arg form
#====================================================================
# name: pipe basic form
# first-arg amp calls
#

#--- code -----------------------------------------------------------
$value = &get_key | &normalize | &fetch
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"value",
		{
			"left": {
				"left": [
					{
						"amp": "get_key",
						"line": 1
					}
				],
				"op": "|",
				"right": [
					{
						"amp": "normalize"
					}
				]
			},
			"op": "|",
			"right": [
				{
					"amp": "fetch"
				}
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"value",
		[
			{
				"in": "fc"
			},
			{
				"a": [
					[
						{
							"in": "fc"
						},
						{
							"a": [
								[
									{
										"in": "fc"
									},
									{
										"fn": "call",
										"rc": {
											"l": 1,
											"var": "get_key"
										}
									}
								]
							],
							"fn": "call",
							"rc": {
								"var": "normalize"
							}
						}
					]
				],
				"fn": "call",
				"rc": {
					"var": "fetch"
				}
			}
		]
	]
]
#--------------------------------------------------------------------

