#--------------------------------------------------------------------

#
# name: generalized `&(EXPR)` as pipe RHS
#====================================================================


# three equivalent forms all normalize to the same method-call shape
#====================================================================
# name: `&<obj>` normalizes to the object's `.call` method
# `&` before any object means "invoke the object's `.call` method" — always,
# no runtime property lookup. Full CaspJ preserves the three surface forms
# distinctly ({var}/method-call for `$foo.call(...)`, `{amp: "foo"}` for
# `&foo`, and `{amp: {var: "foo"}}` for the `&$foo` shorthand). Norm collapses
# all three to a function_call with `fn: "call"` — the runtime sees one shape.
#

#--- code -----------------------------------------------------------
$foo.call('xyz')
&foo 'xyz'
&$foo 'xyz'
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"var": "foo"
		},
		"call",
		{
			"args": [
				{
					"line": 1,
					"value": "xyz"
				}
			]
		},
		{
			"line": 1
		}
	],
	[
		{
			"amp": "foo"
		},
		{
			"line": 2,
			"value": "xyz"
		},
		{
			"line": 2
		}
	],
	[
		{
			"amp": {
				"line": 3,
				"var": "foo"
			}
		},
		{
			"line": 3,
			"value": "xyz"
		},
		{
			"line": 3
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 1,
					"v": "xyz"
				}
			],
			"fn": "call",
			"rc": {
				"var": "foo"
			}
		}
	],
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 2,
					"v": "xyz"
				}
			],
			"fn": "call",
			"rc": {
				"var": "foo"
			}
		}
	],
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 3,
					"v": "xyz"
				}
			],
			"fn": "call",
			"rc": {
				"l": 3,
				"var": "foo"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: `&<obj>` normalizes to the object's `.call` method
#====================================================================


# receiver form on the RHS
#====================================================================
# name: pipe receiver form on the RHS
#

#--- code -----------------------------------------------------------
$html = &normalize($text) | $formatter.render
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"html",
		{
			"left": [
				{
					"amp": "normalize",
					"line": 1
				},
				{
					"line": 1,
					"var": "text"
				}
			],
			"op": "|",
			"right": [
				{
					"var": "formatter"
				},
				"render"
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"html",
		[
			{
				"var": "formatter"
			},
			"render",
			{
				"a": [
					[
						{
							"in": "fc"
						},
						{
							"a": [
								{
									"l": 1,
									"var": "text"
								}
							],
							"fn": "call",
							"rc": {
								"l": 1,
								"var": "normalize"
							}
						}
					]
				]
			}
		]
	]
]
#--------------------------------------------------------------------

#
# name: pipe receiver form on the RHS
#====================================================================


# mixing first-arg (& / $obj.method) and receiver-only (.method / .field)
#====================================================================
# name: pipe mixing first-arg and receiver-only forms
#

#--- code -----------------------------------------------------------
$csv = &get_arr | .sort() | .join(', ')
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"csv",
		{
			"left": {
				"left": [
					{
						"amp": "get_arr",
						"line": 1
					}
				],
				"op": "|",
				"right": {
					"method": "sort"
				}
			},
			"op": "|",
			"right": {
				"args": [
					{
						"line": 1,
						"value": ", "
					}
				],
				"method": "join"
			}
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"csv",
		[
			[
				[
					{
						"in": "fc"
					},
					{
						"fn": "call",
						"rc": {
							"l": 1,
							"var": "get_arr"
						}
					}
				],
				"sort"
			],
			"join",
			{
				"a": [
					{
						"l": 1,
						"v": ", "
					}
				]
			}
		]
	]
]
#--------------------------------------------------------------------

