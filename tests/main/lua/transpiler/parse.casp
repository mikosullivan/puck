	[
		"scope",
		"while_end",
		[
			{
				"amp": "bar",
				"line": 6
			}
		],
		{
			"body": [
				[
					"scope",
					"begin_while",
					{
						"left": {
							"line": 5,
							"var": "attempt"
						},
						"line": 5,
						"op": "<",
						"right": {
							"line": 5,
							"value": 5
						}
					},
					{
						"body": [
							[
								"scope",
								"setvar_op",
								"+",
								"attempt",
								{
									"line": 3,
									"value": 1
								},
								{
									"line": 3
								}
							],
							[
								{
									"amp": "try_connect",
									"line": 4
								}
							]
						]
					},
					{
						"line": 5
					}
				]
			]
		},
		{
			"line": 6
		}
	]
]
