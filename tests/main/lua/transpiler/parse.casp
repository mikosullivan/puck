#
# name: append without whitespace parses the same
#====================================================================


# design decisions for Section 31 (<+ append):
#
#   `LHS <+ RHS` transpiles to a method-call shape:
#     [LHS_expr, "<+", {args: [RHS_expr]}]
#
#   Dispatches on the LHS's class — arrays implement `<+` as push; other
#   classes can implement it if the append semantic makes sense. The LHS is
#   any expression that resolves to a receiver (variable, subscript,
#   property chain, %(url)-shaped fetch lookup, etc.).
#
#   Tokenizer treats `<+` atomically — `$x <+ 5` and `$x<+5` both parse as
#   append. `$x < +5` (space between `<` and `+`) is comparison with a
#   unary-plus RHS; use parens `$x < (+5)` for clarity.

#====================================================================
# Caller pattern with loop-controller slot
#====================================================================

# `$callable.caller.new` returns a fresh caller object for the target.
# When the target declared `as $name`, the caller exposes a `.controller`
# slot; setting it injects the object that binds to `$name` at invocation.
# `.wants_controller?` on the caller returns true iff the target asked for
# a controller — iterator methods use it to skip controller construction
# for targets that don't want one. Full spec at functions/caller/index.md
# § "Loop-controller slot (`as $name` on the target)".


#====================================================================
# name: caller pattern — build, set controller, invoke
# `$foo.caller.new` builds a caller; `.controller = ...` fills the loop-controller slot; `.call arg` invokes with the injected controller
#

#--- code -----------------------------------------------------------
$caller = $foo.caller.new
$caller.controller = $loop_ctrl
$caller.call 1
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"caller",
		[
			[
				{
					"line": 1,
					"var": "foo"
				},
				"caller"
			],
			"new"
		],
		{
			"line": 1
		}
	],
	[
		{
			"line": 2,
			"var": "caller"
		},
		"controller=",
		{
			"args": [
				{
					"line": 2,
					"var": "loop_ctrl"
				}
			]
		},
		{
			"line": 2
		}
	],
	[
		{
			"var": "caller"
		},
		"call",
		{
			"args": [
				{
					"line": 3,
					"value": 1
				}
			]
		},
		{
			"line": 3
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"caller",
		[
			{
				"in": "fc"
			},
			{
				"fn": "new",
				"rc": [
					{
						"in": "fc"
					},
					{
						"fn": "caller",
						"rc": {
							"l": 1,
							"var": "foo"
						}
					}
				]
			}
		]
	],
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 2,
					"var": "loop_ctrl"
				}
			],
			"fn": "controller=",
			"rc": {
				"l": 2,
				"var": "caller"
			}
		}
	],
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 3,
					"v": 1
				}
			],
			"fn": "call",
			"rc": {
				"var": "caller"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: caller pattern — build, set controller, invoke
#====================================================================


#====================================================================
# name: caller `.wants_controller?` introspection idiom
# The `?`-suffix method-name convention is used for boolean introspectors
# like `.wants_controller?`. This is the caller-pattern idiom from
# functions/caller — build a caller, ask if the target wants a controller,
# supply one if so, then fire.
#

#--- code -----------------------------------------------------------
$caller = $foo.caller.new
if $caller.wants_controller?
	$caller.controller = $ctrl
end
$caller.call 1
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"caller",
		[
			[
				{
					"line": 1,
					"var": "foo"
				},
				"caller"
			],
			"new"
		],
		{
			"line": 1
		}
	],
	[
		"scope",
		"if_end",
		{
			"branches": [
				{
					"body": {
						"closure": {
							"body": [
								[
									{
										"line": 3,
										"var": "caller"
									},
									"controller=",
									{
										"args": [
											{
												"line": 3,
												"var": "ctrl"
											}
										]
									},
									{
										"line": 3
									}
								]
							],
							"params": []
						}
					},
					"cond": [
						{
							"line": 2,
							"var": "caller"
						},
						"wants_controller?"
					]
				}
			]
		},
		{
			"line": 4
		}
	],
	[
		{
			"var": "caller"
		},
		"call",
		{
			"args": [
				{
					"line": 5,
					"value": 1
				}
			]
		},
		{
			"line": 5
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"caller",
		[
			{
				"in": "fc"
			},
			{
				"fn": "new",
				"rc": [
					{
						"in": "fc"
					},
					{
						"fn": "caller",
						"rc": {
							"l": 1,
							"var": "foo"
						}
					}
				]
			}
		]
	],
	[
		"scope",
		"if_end",
		{
			"branches": [
				{
					"bd": {
						"cl": {
							"bd": [
								[
									{
										"in": "fc"
									},
									{
										"a": [
											{
												"l": 3,
												"var": "ctrl"
											}
										],
										"fn": "controller=",
										"rc": {
											"l": 3,
											"var": "caller"
										}
									}
								]
							],
							"pm": []
						}
					},
					"cond": [
						{
							"in": "fc"
						},
						{
							"fn": "wants_controller?",
							"rc": {
								"l": 2,
								"var": "caller"
							}
						}
					]
				}
			]
		},
		{
			"l": 4
		}
	],
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 5,
					"v": 1
				}
			],
			"fn": "call",
			"rc": {
				"var": "caller"
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: caller `.wants_controller?` introspection idiom
#====================================================================


#====================================================================
# name: closure with `as $loop` controller binding
# `as $loop` on the closure opener is signature metadata — lifted to an
# `as: "loop"` field on the closure atom, NOT captured as a body statement.
# The runtime uses this field via `$caller.wants_controller?` to know
# whether the target asked for a loop-controller. Same rewrite applies
# to `function &foo() as $l`, `method &foo() as $l`, `do(...) as $l`,
# `while ... as $loop`, `until ... as $loop`, and `begin ... as $block`.
#

#--- code -----------------------------------------------------------
$foo = closure($idx) as $loop
	puts $loop.index
end
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"foo",
		{
			"closure": {
				"as": "loop",
				"body": [
					[
						{
							"bwc": "puts"
						},
						[
							{
								"line": 2,
								"var": "loop"
							},
							"index"
						],
						{
							"line": 2
						}
					]
				],
				"params": [
					"idx"
				]
			}
		},
		{
			"line": 3
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"foo",
		{
			"cl": {
				"as": "loop",
				"bd": [
					[
						{
							"bwc": "puts"
						},
						[
							{
								"in": "fc"
							},
							{
								"fn": "index",
								"rc": {
									"l": 2,
									"var": "loop"
								}
							}
						]
					]
				],
				"pm": [
					"idx"
				]
			}
		},
		{
			"l": 3
		}
	]
]
#--------------------------------------------------------------------

#
# name: closure with `as $loop` controller binding
#====================================================================


#====================================================================
# Weird stuff
#====================================================================

#====================================================================
# name: nested long-form function assignment with rich-metadata param whose default is another function
# every source comment preserved
#

#--- code -----------------------------------------------------------
$foo = function( # outer function
	# first and only param for outer function
	$myfunc: {
			# set param as optional
			optional: true,

			# next param, which defaults to a function
			default: function($port: {'default':80}) # function as default param
				puts $port
			end # end of default param
		}
	)
	&myfunc()
end # end of outer function
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"foo",
		{
			"function": {
				"body": [
					[
						{
							"amp": "myfunc",
							"line": 13
						}
					]
				],
				"params": [
					{
						"comment": "outer function"
					},
					{
						"comment": "first and only param for outer function"
					},
					{
						"meta": [
							{
								"comment": "set param as optional"
							},
							[
								"optional",
								{
									"value": true
								}
							],
							{
								"comment": "next param, which defaults to a function"
							},
							[
								"default",
								{
									"function": {
										"body": [
											{
												"comment": "function as default param",
												"line": 1
											},
											[
												{
													"bwc": "puts"
												},
												{
													"line": 2,
													"var": "port"
												},
												{
													"line": 2
												}
											]
										],
										"params": [
											{
												"meta": [
													[
														"default",
														{
															"value": 80
														}
													]
												],
												"name": "port"
											}
										]
									},
									"line": 3
								}
							],
							{
								"comment": "end of default param",
								"line": 3
							}
						],
						"name": "myfunc"
					}
				]
			}
		},
		{
			"line": 14
		}
	],
	{
		"comment": "end of outer function",
		"line": 14
	}
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"foo",
		{
			"fn": {
				"bd": [
					[
						{
							"in": "fc"
						},
						{
							"fn": "call",
							"rc": {
								"l": 13,
								"var": "myfunc"
							}
						}
					]
				],
				"pm": [
					{
						"meta": [
							[
								"optional",
								{
									"v": true
								}
							],
							[
								"default",
								{
									"fn": {
										"bd": [
											[
												{
													"bwc": "puts"
												},
												{
													"l": 2,
													"var": "port"
												}
											]
										],
										"pm": [
											{
												"meta": [
													[
														"default",
														{
															"v": 80
														}
													]
												],
												"name": "port"
											}
										]
									},
									"l": 3
								}
							]
						],
						"name": "myfunc"
					}
				]
			}
		},
		{
			"l": 14
		}
	]
]
