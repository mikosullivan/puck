#
# name: pipe accessor chain via receiver form
#====================================================================

# sticky null-propagation with |&, wrapped over multiple lines

#====================================================================
# name: multi-line pipe with trailing `|&`
# `|&` is the null-safe pipe (distinct from `|`); trailing `|` or `|&` at line end continues the statement
#

#--- code -----------------------------------------------------------
$saved = &get_record 42 |&
	&validate |
	&transform |
	&save
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"saved",
		{
			"left": {
				"left": {
					"left": [
						{
							"amp": "get_record",
							"line": 1
						},
						{
							"line": 1,
							"value": 42
						}
					],
					"op": "|&",
					"right": [
						{
							"amp": "validate"
						}
					]
				},
				"op": "|",
				"right": [
					{
						"amp": "transform"
					}
				]
			},
			"op": "|",
			"right": [
				{
					"amp": "save"
				}
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"saved",
		[
			{
				"in": "fc"
			},
			{
				"a": [
					[
						{
							"in": "fc"
						},
						{
							"a": [
								[
									{
										"in": "fc"
									},
									{
										"a": [
											[
												{
													"in": "fc"
												},
												{
													"a": [
														{
															"l": 1,
															"v": 42
														}
													],
													"fn": "call",
													"rc": {
														"l": 1,
														"var": "get_record"
													}
												}
											]
										],
										"fn": "call",
										"rc": {
											"var": "validate"
										}
									}
								]
							],
							"fn": "call",
							"rc": {
								"var": "transform"
							}
						}
					]
				],
				"fn": "call",
				"rc": {
					"var": "save"
				}
			}
		]
	]
]
#--------------------------------------------------------------------

#
# name: multi-line pipe with trailing `|&`
#====================================================================

#====================================================================
# documentation and vibecode heredocs
#====================================================================

# documentation and vibecode are ordinary sys-methods invoked as calls.
# The heredoc form is the common one — the block body becomes the single
# arg. Runtime rule: neither method interpolates its arg even when the
# terminator is quoted (`<<"EOF"`). The transpiler doesn't enforce that
# — it emits the same `[{sys: NAME}, {value: text, dq?}]` shape as any
# other sys-call with a heredoc arg; the "no interpolation" rule is
# runtime-side.


#====================================================================
# name: documentation with plain heredoc
# `documentation <<EOF ... EOF` — sys-method call with heredoc body as arg
#

#--- code -----------------------------------------------------------
$foo = 1

documentation <<EOF
plain doc text
across two lines
EOF

$foo = 2
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"foo",
		{
			"line": 1,
			"value": 1
		},
		{
			"line": 1
		}
	],
	[
		{
			"bwc": "documentation"
		},
		{
			"value": "plain doc text\nacross two lines"
		},
		{
			"line": 3
		}
	],
	[
		"scope",
		"setvar",
		"foo",
		{
			"line": 5,
			"value": 2
		},
		{
			"line": 5
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"foo",
		{
			"l": 1,
			"v": 1
		}
	],
	[
		{
			"in": "as"
		},
		"foo",
		{
			"l": 5,
			"v": 2
		}
	]
]
#--------------------------------------------------------------------

