# instance
#====================================================================


#====================================================================
# name: bare instance (no construction args) as setvar RHS
#

#--- code -----------------------------------------------------------
$greeter = instance
	method &hello($name)
		return 'Hello, ' + $name
	end
end
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"greeter",
		{
			"instance": {
				"body": [
					[
						{
							"line": 4,
							"method": {
								"body": [
									[
										"scope",
										"return",
										{
											"left": {
												"line": 3,
												"value": "Hello, "
											},
											"line": 3,
											"op": "+",
											"right": {
												"line": 3,
												"var": "name"
											}
										},
										{
											"line": 3
										}
									]
								],
								"name": "hello",
								"params": [
									"name"
								]
							}
						}
					]
				]
			}
		},
		{
			"line": 5
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "as"
		},
		"greeter",
		{
			"instance": {
				"bd": [
					[
						{
							"l": 4,
							"method": {
								"bd": [
									[
										"scope",
										"return",
										[
											{
												"in": "fc"
											},
											{
												"a": [
													{
														"l": 3,
														"var": "name"
													}
												],
												"fn": "+",
												"rc": {
													"l": 3,
													"v": "Hello, "
												}
											}
										]
									]
								],
								"name": "hello",
								"pm": [
									"name"
								]
							}
						}
					]
				]
			}
		},
		{
			"l": 5
		}
	]
]
