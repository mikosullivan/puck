			{
				"a": [
					[
						{
							"in": "fc"
						},
						{
							"a": [
								[
									{
										"in": "fc"
									},
									{
										"fn": "call",
										"rc": {
											"l": 1,
											"var": "foo"
										}
									}
								]
							],
							"fn": "call",
							"rc": [
								{
									"in": "fc"
