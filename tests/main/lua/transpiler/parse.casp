			"kw": [
				[
					"timeout",
					{
						"line": 1,
						"value": 30
					}
				],
				[
					"retries",
					{
						"line": 1,
						"value": 3
					}
				]
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 1,
					"v": "https://x"
				}
			],
			"fn": "call",
			"kw": [
				[
					"timeout",
					{
						"l": 1,
						"v": 30
					}
				],
				[
					"retries",
					{
						"l": 1,
						"v": 3
					}
				]
			],
			"rc": {
				"var": "fetch"
			}
		}
	]
]
