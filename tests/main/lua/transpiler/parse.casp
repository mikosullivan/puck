#
# name: sys-receiver-as-nested-expression inside operator context ($x variant)
#====================================================================


# design decisions made unilaterally for Section 16:
#
#   - sys atom shape: {sys: "name"} — parallel to {var: "name"} and {bwc: "name"}
#   - sys-receiver method call: [{sys: "name"}, method, {args: [...]}] — same
#     shape as $-receiver method call, with the {sys: X} receiver in place of
#     {var: X}. runtime dispatches on receiver type.
#   - sys subscript: [{sys: "name"}, "[]", {args: [key_expr]}] — subscript is
#     a "[]" method call, matching the $-var and hash/array subscript shape.
#   - {sys: X}.attr with no parens uses the same "attr" method-name shape as
#     $recv.attr — no separate "field access" node. runtime distinguishes.
#

#====================================================================
# Pipes
#====================================================================


# The statement-leading pipe (`| bwc [args]`) rewrites the immediately-
# preceding statement by wrapping its value in a bwc call. Whitespace and
# newlines around the pipe are not significant — the three tests below
# produce identical CaspJ.

#====================================================================
# name: pipe on its own line after a multi-line method
#

#--- code -----------------------------------------------------------
method &foo()
end

| private
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"left": {
				"line": 2,
				"method": {
					"body": [],
					"name": "foo",
					"params": []
				}
			},
			"line": 4,
			"op": "|",
			"right": [
				{
					"bwc": "private",
					"line": 4
				}
			]
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		[
			{
				"bwc": "private",
				"l": 4
			},
			{
				"l": 2,
				"method": {
					"bd": [],
					"name": "foo",
					"pm": []
				}
			}
		]
	]
]
#--------------------------------------------------------------------

#
# name: pipe on its own line after a multi-line method
#====================================================================


#====================================================================
# name: pipe on the same line as `end` after a multi-line method
#

#--- code -----------------------------------------------------------
method &foo()
end | private
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"left": {
				"line": 2,
				"method": {
