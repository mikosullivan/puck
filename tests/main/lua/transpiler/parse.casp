#--------------------------------------------------------------------

#
# name: variable object multi-segment attribute chain
#====================================================================


# design decisions made unilaterally for Section 24:
#
#   - varobj atom shape: {varobj: "name"} — parallel to {var: "name"}.
#     JSON key kept as a plain identifier (not "$$") so it's addressable
#     from clients that can't emit special JSON keys.
#   - $$name is tried BEFORE $name in the receiver-recognition helper, since
#     the plain-var pattern would gobble the first $ and misparse the second.
#   - $$name in expression AND statement position both work; $$name.attr and
#     $$name.attr = value use the same receiver-swap approach as $-var
#     receivers.
#
# Reassigning the varobj slot itself (`$$foo = X`) is NOT valid Caspian —
# a varobj IS the slot; there is no "replace the varobj with a different
# one" operation. The parser catches this at transpile time with a specific
# error steering the author toward `$foo = X` (which reassigns the value
# the slot holds). Negative fixture: parse-negative.casp § `varobj-slot
# reassignment ($$foo = X) raises with steering hint`.

#====================================================================
# Function calls (survey)
#====================================================================



# language survey for bwc-with-args variations beyond Section 2's basics.
# Each of the survey lines below has a settled shape now — the Section 12
# kwargs/splat fixtures cover the shape family; this section stays a survey
# rather than duplicating those tests.
#
#   &foo                 — covered by Section 2
#   &foo()               — covered by Section 2
#   &foo 'bar'           — covered by Section 2
#   &foo gup: 'bar'      — kwarg paren-less: `[{amp:foo}, {kw:[[gup, {value:bar}]]}]`
#   &foo(gup: 'bar')     — kwarg parens form: same shape
#   &foo(gup: 'bar', 2)  — mixed → RAISES per "positional after keyword raises" rule

#====================================================================
# name: amp-call kwargs surface
# bareword, empty parens, positional, kwarg-bareword, kwarg-parens
#

#--- code -----------------------------------------------------------
&foo
&foo()
&foo 'bar'
&foo gup: 'bar'
&foo(gup: 'bar')
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		{
			"amp": "foo",
			"line": 1
		}
	],
	[
		{
			"amp": "foo",
			"line": 2
		}
	],
	[
		{
			"amp": "foo"
		},
		{
			"line": 3,
			"value": "bar"
		},
		{
			"line": 3
		}
	],
	[
		{
			"amp": "foo"
		},
		{
			"kw": [
				[
					"gup",
					{
						"line": 4,
						"value": "bar"
					}
				]
			]
		},
		{
			"line": 4
		}
	],
	[
		{
			"amp": "foo"
		},
		{
			"kw": [
				[
					"gup",
					{
						"line": 5,
						"value": "bar"
					}
				]
			]
		},
		{
			"line": 5
		}
	]
]
#--------------------------------------------------------------------

#--- norm -----------------------------------------------------------
[
	[
		{
			"in": "fc"
		},
		{
			"fn": "call",
			"rc": {
				"l": 1,
				"var": "foo"
			}
		}
	],
	[
		{
			"in": "fc"
		},
		{
			"fn": "call",
			"rc": {
				"l": 2,
				"var": "foo"
			}
		}
	],
	[
		{
			"in": "fc"
		},
		{
			"a": [
				{
					"l": 3,
					"v": "bar"
				}
			],
			"fn": "call",
			"rc": {
				"var": "foo"
			}
		}
	],
	[
		{
			"in": "fc"
		},
		{
			"fn": "call",
			"kw": [
				[
					"gup",
					{
						"l": 4,
						"v": "bar"
					}
				]
			],
			"rc": {
				"var": "foo"
			}
		}
	],
	[
		{
			"in": "fc"
		},
		{
			"fn": "call",
			"kw": [
				[
					"gup",
					{
						"l": 5,
						"v": "bar"
					}
				]
			],
			"rc": {
				"var": "foo"
			}
		}
	]
]
