#====================================================================
# name: hash element get as RHS of assignment
#

#--- code -----------------------------------------------------------
$item = $hash['a']
#--------------------------------------------------------------------

#--- full -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"item",
		[
			{
				"line": 1,
				"var": "hash"
			},
			"[]",
			{
				"args": [
					{
						"line": 1,
						"value": "a"
					}
				],
				"line": 1
			}
		],
		{
			"line": 1
		}
	]
]
