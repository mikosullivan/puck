$text = 'Hello, World'

$result = &normalize($text) |
          &trim |
          &upcase

$result = &fetch_record |&
          &validate |
          &transform |
          &save

$length = $text | &count_words | &double

$mikobase.q0({action: :select, class: 'foo.com/character'}) |
    &filter_active |
    &sort_by_rank |
    &format_report |
    &send_email
