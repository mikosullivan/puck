%vibecode {
	"class": "color",
	"purpose": "represent_a_single_color_as_hex_string",
	"storage": "hex_string_eg_#ff3388_or_#ff338880",
	"notes": ["transparency_suffix_optional_appended_as_two_hex_digits",
		"setters_preserve_transparency_suffix_when_present"],
	"methods": ["initialize", "hex", "rgb",
		"red", "red=", "green", "green=", "blue", "blue=",
		"transparency", "transparency="]
}

class 'color'
    field @hex

    self.object.define do
        function &blue
            return color.new(hex: '#0000ff')
        end
    end

    function &initialize($hex)
        @hex = $hex
    end

    function &hex
        return @hex
    end

    function &rgb
        $r = @hex[1, 2].hex
        $g = @hex[3, 2].hex
        $b = @hex[5, 2].hex
        return [$r, $g, $b]
    end

    function &red
        return @hex[1, 2].hex
    end

    function &red=($value)
        $t = @hex[7, @hex.length - 7]
        @hex = '#' + $value.to_hex.right_justify(2).replace(' ', '0') + @hex[3, 2] + @hex[5, 2] + $t
    end

    function &green
        return @hex[3, 2].hex
    end

    function &green=($value)
        $t = @hex[7, @hex.length - 7]
        @hex = '#' + @hex[1, 2] + $value.to_hex.right_justify(2).replace(' ', '0') + @hex[5, 2] + $t
    end

    function &blue
        return @hex[5, 2].hex
    end

    function &blue=($value)
        $t = @hex[7, @hex.length - 7]
        @hex = '#' + @hex[1, 2] + @hex[3, 2] + $value.to_hex.right_justify(2).replace(' ', '0') + $t
    end

    function &transparency
        if (@hex.length == 9)
            return @hex[7, 2].hex
        else
            return 0
        end
    end

    function &transparency=($value)
        if ($value == 0)
            @hex = '#' + @hex[1, 2] + @hex[3, 2] + @hex[5, 2]
        else
            @hex = '#' + @hex[1, 2] + @hex[3, 2] + @hex[5, 2] + $value.to_hex.right_justify(2).replace(' ', '0')
        end
    end
end
