{
    "classes": {

        "unotate.com/playwright": {
            "fields": {
                "name": {
                    "class": "hash",
                    "of": "string",
                    "required": true,
                    "default": {"collapse": true},
                    "fields": {
                        "surname": {"required": true},
                        "middle":  {},
                        "given":   {"required": true}
                    }
                },
                "id":      {"class": "string", "required": true, "unique": true},
                "image_url": {"class": "url"}
            }
        },

        "unotate.com/play": {
            "fields": {
                "id":  {"class": "string", "required": true, "unique": true},
                "title": {
                    "class": "hash",
                    "of": "string",
                    "required": true,
                    "fields": {
                        "long":  {"required": true, "collapse": true},
                        "short": {"collapse": true}
                    }
                }
            }
        },

        "unotate.com/play-playwright": {
            "fields": {
                "play":       {"class": "mikobase.com/reference", "allowed_class": "unotate.com/play"},
                "playwright": {"class": "mikobase.com/reference", "allowed_class": "unotate.com/playwright"}
            },
            "join": ["play", "playwright"]
        },

        "unotate.com/act": {
            "fields": {
                "play":   {"class": "mikobase.com/reference", "allowed_class": "unotate.com/play"},
                "number": {"class": "number", "integer_only": true, "min": 1},
                "title":  {"class": "string", "collapse": true}
            },
            "join": ["play", "number"]
        },

        "unotate.com/scene": {
            "fields": {
                "act":      {"class": "mikobase.com/reference", "allowed_class": "unotate.com/act"},
                "number":   {"class": "number", "integer_only": true, "min": 1},
                "title":    {"class": "string", "collapse": true},
                "location": {"class": "string", "collapse": true},
                "time":     {"class": "string"},
                "language": {"class": "string"}
            },
            "join": ["act", "number"]
        },

        "unotate.com/character": {
            "fields": {
                "play":      {"class": "mikobase.com/reference", "allowed_class": "unotate.com/play", "required": true},
                "name": {
                    "class": "hash",
                    "of": "string",
                    "fields": {
                        "long":  {"required": true, "collapse": true},
                        "short": {"collapse": true}
                    }
                },
                "gender":    {"class": "string"},
                "archetype": {"class": "string"},
                "dies":      {"class": "boolean", "default": false},
                "aliases":   {"class": "array", "of": "string"}
            }
        },

        "unotate.com/scene-character": {
            "fields": {
                "scene":     {"class": "mikobase.com/reference", "allowed_class": "unotate.com/scene"},
                "character": {"class": "mikobase.com/reference", "allowed_class": "unotate.com/character"}
            },
            "join": ["scene", "character"]
        },

        "unotate.com/speech": {
            "fields": {
                "scene":     {"class": "mikobase.com/reference", "allowed_class": "unotate.com/scene", "required": true},
                "character": {"class": "mikobase.com/reference", "allowed_class": "unotate.com/character", "required": true}
            }
        },

        "unotate.com/line": {
            "fields": {
                "speech":        {"class": "mikobase.com/reference", "allowed_class": "unotate.com/speech", "required": true},
                "global_number": {"class": "number", "integer_only": true, "min": 1},
                "form":          {"class": "string"},
                "text":          {"class": "string", "required": true}
            }
        },

        "unotate.com/stage-direction": {
            "fields": {
                "scene": {"class": "mikobase.com/reference", "allowed_class": "unotate.com/scene", "required": true},
                "text":  {"class": "string", "required": true}
            }
        },

        "unotate.com/image": {
            "fields": {
                "title":  {"class": "string", "collapse": true},
                "date":   {"class": "number", "integer_only": true},
                "artist": {"class": "string", "collapse": true},
                "source": {
                    "class": "hash",
                    "fields": {
                        "primary":    {"class": "string"},
                        "repository": {"class": "string"},
                        "url":        {"class": "string"}
                    }
                },
                "variants": {
                    "class": "hash",
                    "of": "string",
                    "fields": {
                        "full":    {},
                        "post_it": {},
                        "small":   {}
                    }
                }
            }
        },

        "unotate.com/image-play": {
            "fields": {
                "image": {"class": "mikobase.com/reference", "allowed_class": "unotate.com/image"},
                "play":  {"class": "mikobase.com/reference", "allowed_class": "unotate.com/play"}
            },
            "join": ["image", "play"]
        }

    }
}
