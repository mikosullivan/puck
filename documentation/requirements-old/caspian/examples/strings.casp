%vibecode <<EOF
{
  "purpose": "Caspian string types, heredocs, pattern matching, and safe navigation",
  "demonstrates": [
    "single-quoted strings (no interpolation)",
    "double-quoted strings (interpolation)",
    "colon shorthand for symbol strings",
    "heredoc variants: raw, plain, interpolated",
    "match() returning a match object with .text .start .end .groups",
    "match?() returning boolean",
    "safe navigation operator &. (nil-guard method call)"
  ]
}
EOF

%vibecode <<EOF
{
  "purpose": "The four basic string forms",
  "note":    "$a is literal; $b interpolates $a inline; $c interpolates an arithmetic expression; $d and $e are identical — colon shorthand :foo is sugar for the string 'foo'"
}
EOF

$a = 'single quoted — no interpolation'
$b = "double quoted — $a is interpolated"
$c = "expression: #{1 + 2}"
$d = :colon_shorthand
$e = 'colon_shorthand'

%vibecode <<EOF
{
  "purpose": "Raw heredoc (<<'EOF') — no interpolation; indentation is preserved as written",
  "note":    "single-quoted delimiter suppresses interpolation entirely; equivalent to a single-quoted string but multi-line"
}
EOF

$heredoc_raw = <<'EOF'
    This is not interpolated.
    $name stays as-is.
EOF

%vibecode <<EOF
{
  "purpose": "Plain heredoc (<<EOF) — also no interpolation",
  "note":    "unquoted delimiter behaves the same as single-quoted; neither form interpolates"
}
EOF

$heredoc_plain = <<EOF
    Also not interpolated.
EOF

%vibecode <<EOF
{
  "purpose": "Interpolated heredoc (<<\"EOF\") — $name and #{expr} both expand",
  "note":    "double-quoted delimiter enables interpolation; $name.rank uses dot access inside the interpolation block"
}
EOF

$name = 'Picard'

$heredoc_interpolated = <<"EOF"
    Hello, $name.
    Rank: #{$name.rank}
EOF

%vibecode <<EOF
{
  "purpose": "Pattern matching with match() — Lua-style patterns",
  "returns": "match object with .text (full match), .start (1-based start pos), .end (end pos), .groups (capture array)",
  "note":    "%a+ matches one or more alphabetic characters; match() returns null if no match"
}
EOF

$match = $name.match('%a+')
puts($match.text)
puts($match.start)
puts($match.end)

%vibecode <<EOF
{
  "purpose": "Predicate form match?() — returns boolean, discards the match object",
  "note":    "%u%l+ matches one uppercase letter followed by one or more lowercase — i.e. a capitalized word"
}
EOF

if ($name.match?('%u%l+'))
    puts('starts with capital')
end

%vibecode <<EOF
{
  "purpose": "Safe navigation operator &. — calls the method only if the receiver is non-null",
  "note":    "$safe is null if $name is null; $chained is null if either $name or the match result is null — null propagates through the chain"
}
EOF

$safe = $name&.upcase
$chained = $name.match('%a+')&.text
