%vibecode <<EOF
{
  "purpose": "Caspian system facilities — %chain context, null flavors, untrusted sandboxing, jail, and %process.exit",
  "demonstrates": [
    "%chain — request-scoped key/value context inherited by child scopes",
    "%chain.scope — isolated scope block where %chain changes stay local",
    "%chain.misc.clear and %chain.clear — scope clearing variants",
    "%puck class lookup for well-known types",
    "null flavors — subclasses of puck.uno/null that are falsey but typed",
    "untrusted() — wraps a function to run in a sandboxed environment",
    ".object.jail(:call) — restricts a function object to only the :call method",
    "%process.exit — terminates the process"
  ]
}
EOF

%vibecode <<EOF
{
  "purpose": "Set %chain context values — propagate user and request_id to child scopes",
  "note":    "%chain values are available to all code called within the current scope; puts reads back the value immediately"
}
EOF

%chain['user'] = 'picard'
%chain['request_id'] = '42'
puts(%chain['user'])

%vibecode <<EOF
{
  "purpose": "%chain.scope — isolates %chain mutations to the block; changes do not propagate back to the outer scope",
  "note":    "inside the block, %chain['user'] is 'riker'; after the block, it reverts to 'picard'; scope creates a shallow copy of the chain"
}
EOF

%chain.scope do
    %chain['user'] = 'riker'
    puts(%chain['user'])
end

puts(%chain['user'])

%vibecode <<EOF
{
  "purpose": "%chain.misc.clear — scope block that clears only the 'misc' namespace of %chain within the block",
  "note":    "misc is a sub-namespace within %chain for miscellaneous per-request data; .clear resets it for the duration of the block"
}
EOF

%chain.misc.clear do
    puts(%chain['user'])
end

%vibecode <<EOF
{
  "purpose": "%chain.clear — scope block that clears the entire %chain within the block",
  "note":    "all chain keys including user and request_id are cleared inside; restored on block exit"
}
EOF

%chain.clear do
end

%vibecode <<EOF
{
  "purpose": "Class lookups via %puck — retrieve well-known Puckverse class objects by UNS address",
  "note":    "these are class objects (not instances); used to call .new or inspect the class; puck.uno/mikobase/memory is the in-memory hive"
}
EOF

$null_class  = %puck['https://puck.uno/null']
$true_class  = %puck['https://puck.uno/true']
$false_class = %puck['https://puck.uno/false']
$hive_class  = %puck['https://puck.uno/mikobase/memory']

%vibecode <<EOF
{
  "purpose": "Instantiate a standard null value",
  "note":    "puck.uno/null is the base null class; $my_null is falsey in conditionals; prefer typed null subclasses when the reason for null matters"
}
EOF

$my_null = %puck['https://puck.uno/null'].new

%vibecode <<EOF
{
  "purpose": "Null flavor — domain-specific null subclass that is falsey but carries type information",
  "pattern": "inherit from puck.uno/null to create a typed null; code can check the class to know WHY a value is absent",
  "note":    "myapp.com/null/unknown evaluates as false in conditionals but is a distinct class from puck.uno/null"
}
EOF

class
    inherits 'puck.uno/null'
end

%vibecode <<EOF
{
  "purpose": "Verify that the null flavor is falsey — the if body is never reached",
  "note":    "demonstrates that null flavor instances behave as null in conditionals despite being subclass instances"
}
EOF

$unknown = %puck['https://myapp.com/null/unknown'].new

if ($unknown)
    puts('never reached')
end

%vibecode <<EOF
{
  "purpose": "untrusted() — wraps a function to execute in a sandboxed environment",
  "note":    "use when running code from untrusted sources (e.g. downloaded Puck functions); the sandbox restricts access to system resources; &foo is called normally but executes under sandbox constraints"
}
EOF

$foo = function()
end

$foo = untrusted($foo)
&foo

%vibecode <<EOF
{
  "purpose": "jail — restricts an existing function object to only the specified methods",
  "params":  {":call": "the only method permitted on the jailed object"},
  "note":    "$safe can only be invoked via &safe (i.e. .call); all other methods on $risky.object are inaccessible through $safe; useful for passing a callable to untrusted code without exposing the full object"
}
EOF

function &risky
end

$safe = $risky.object.jail(:call)
&safe

%vibecode <<EOF
{
  "purpose": "Terminate the current Caspian process",
  "note":    "%process.exit stops execution immediately; no cleanup callbacks are run"
}
EOF

%process.exit
