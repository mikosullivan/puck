%vibecode <<EOF
{
  "purpose": "Charlie function definitions, anonymous functions, yield, caller objects, and variable-object ($$) references",
  "demonstrates": [
    "named function definition with &greet syntax",
    "calling a function with keyword arguments",
    "yield — passes control to a caller-supplied block",
    "anonymous function assigned to a variable",
    "%call.dispatcher and %blocks for multi-block functions",
    ".caller — builds a deferred call object with settable keyword args",
    "$$ — variable-object reference (the variable itself, not its value)"
  ]
}
EOF

%vibecode <<EOF
{
  "purpose": "Named function definition — &greet takes two positional parameters",
  "returns": "greeting string by implicit return (last expression in function body)",
  "note":    "function body implicitly returns the last expression; explicit 'return' also works"
}
EOF

function &greet($name, $rank)
    'Hello, ' + rank + ' ' + name
end

%vibecode <<EOF
{
  "purpose": "Call &greet with keyword arguments",
  "note":    "all arguments are passed by keyword name; positional parameters match to keyword names at call time"
}
EOF

puts &greet(name: 'Picard', rank: 'Captain')

%vibecode <<EOF
{
  "purpose": "yield — passes execution to the block supplied by the caller",
  "params":  {"value": "any — passed as the block parameter $v"},
  "note":    "yield suspends the function and runs the caller's do block; execution resumes in &apply after the block returns"
}
EOF

function &apply($value)
    yield value
end

%vibecode <<EOF
{
  "purpose": "Call &apply with a block — the do block receives the yielded value as $v",
  "note":    "the block parameter $v corresponds to the value passed to yield; prints 42"
}
EOF

&apply(value: 42) do($v)
    puts $v
end

%vibecode <<EOF
{
  "purpose": "Anonymous function assigned to a variable — equivalent to a named function but stored in $double",
  "note":    "anonymous functions use 'function($params)' syntax without the & name; called as &double or $double.call"
}
EOF

$double = function($n)
    $n * 2
end

puts &double(21)

%vibecode <<EOF
{
  "purpose": "Multi-block function using %call.dispatcher and %blocks",
  "note":    "%call.dispatcher is the dispatcher for the current call; %blocks is the array of do blocks supplied by the caller; yield %blocks[N] runs the Nth block"
}
EOF

function &build_report
    $result = %call.dispatcher

    yield %blocks[0]
    yield %blocks[1]
    yield %blocks[2]
end

%vibecode <<EOF
{
  "purpose": "Call &build_report with a block — the block receives each yielded section",
  "note":    "same do block is called three times, once per yield; $section is the value passed by each yield"
}
EOF

&build_report do($section)
    puts($section)
end

%vibecode <<EOF
{
  "purpose": "caller — builds a deferred call object; keyword arguments are set as properties before calling",
  "note":    "$adder.rank and $adder.name set the keyword args; $adder.call executes &greet with those args"
}
EOF

$adder = &greet.caller
$adder.rank = 'Admiral'
$adder.name = 'Janeway'
$adder.call

%vibecode <<EOF
{
  "purpose": "Anonymous function that returns a boolean — used as a validator",
  "returns": "true if $record has no name, false otherwise",
  "note":    "explicit 'return' is valid inside anonymous functions; the function is called with a record hash"
}
EOF

$validate = function($record)
    return $record['name'] == null
end

%vibecode <<EOF
{
  "purpose": "$$ (variable-object reference) — refers to the variable itself, not its current value",
  "note":    "$$validate is the variable object for $validate; useful for passing a function reference without calling it — the callee can invoke it later via .call"
}
EOF

$var = $$validate
