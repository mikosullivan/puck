%vibecode <<EOF
{
  "purpose": "Introductory Charlie example — variables, string interpolation, literals, and basic data structures",
  "demonstrates": [
    "variable assignment with $name syntax",
    "string concatenation with +",
    "double-quoted string interpolation (#{expr} and $var inline)",
    "boolean and null literals",
    "array literal",
    "hash literal with symbol keys"
  ]
}
EOF

%vibecode <<EOF
{
  "purpose": "Assign a string to a variable and build a greeting",
  "note":    "string concatenation uses + operator; single-quoted strings do not interpolate"
}
EOF

$name = 'Jean-Luc'
$greeting = 'Hello, ' + $name
puts($greeting)

%vibecode <<EOF
{
  "purpose": "Double-quoted string with inline variable ($name) and expression interpolation (#{$age})",
  "note":    "#{...} evaluates any expression; bare $name expands the variable directly without braces"
}
EOF

$age = 65
$message = "Captain #{$name} is #{$age} years old"
puts($message)

%vibecode <<EOF
{
  "purpose": "Boolean and null literals",
  "note":    "true and false are the boolean literals; null is the null literal — distinct from puck.uno/null subclasses"
}
EOF

$active = true
$nothing = null

%vibecode <<EOF
{
  "purpose": "Array and hash literals",
  "note":    "arrays use [] with comma-separated values; hashes use {} with symbol-key: value pairs — key order is significant"
}
EOF

$scores = [98, 72, 85, 91]
$person = {name: 'Spock', rank: 'Commander', age: 162}
