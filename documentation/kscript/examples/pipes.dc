%vibecode <<EOF
{
  "purpose": "KScript pipe operator examples — function composition via |",
  "demonstrates": [
    "basic pipe: value flows left-to-right through functions",
    "pipe-bang |& — propagates null; aborts the chain if any step returns null",
    "inline pipe on a single expression",
    "pipe after a method call — result of q0 flows into filter/sort/format/send"
  ],
  "semantics": "each function in a pipe receives the previous function's return value as its argument; pipes compose left-to-right"
}
EOF

%vibecode <<EOF
{
  "purpose": "Basic pipe — $text flows into &normalize, then &trim, then &upcase",
  "note":    "equivalent to &upcase(&trim(&normalize($text))); pipe form is preferred for readability"
}
EOF

$text = 'Hello, World'

$result = &normalize($text) |
          &trim |
          &upcase

%vibecode <<EOF
{
  "purpose": "Pipe-bang |& — null-safe pipe; aborts the chain if any step returns null",
  "note":    "if &fetch_record returns null, &validate and subsequent functions are never called; $result is null; use |& anywhere a null result should short-circuit the chain"
}
EOF

$result = &fetch_record |&
          &validate |
          &transform |
          &save

%vibecode <<EOF
{
  "purpose": "Inline pipe on a simple expression — $text piped through two functions",
  "note":    "pipes can be written on one line; no difference in semantics from multi-line form"
}
EOF

$length = $text | &count_words | &double

%vibecode <<EOF
{
  "purpose": "Pipe after a method call — q0 result flows into a report pipeline",
  "note":    "the q0 call returns a collection; that collection is the input to &filter_active; pipes can start from any expression, not just variable references"
}
EOF

$mikobase.q0({action: :select, class: 'foo.com/character'}) |
    &filter_active |
    &sort_by_rank |
    &format_report |
    &send_email
