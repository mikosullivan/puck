{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Caspian",
    "scopeName": "source.casp",
    "patterns": [
        {"include": "#comments"},
        {"include": "#heredocs"},
        {"include": "#strings"},
        {"include": "#keywords"},
        {"include": "#constants"},
        {"include": "#numbers"},
        {"include": "#system-methods"},
        {"include": "#variables"},
        {"include": "#instance-vars"},
        {"include": "#functions"},
        {"include": "#colon-strings"},
        {"include": "#operators"}
    ],
    "repository": {

        "comments": {
            "name": "comment.line.number-sign.casp",
            "match": "#(?!\\{).*$"
        },

        "heredocs": {
            "patterns": [
                {
                    "name": "string.unquoted.heredoc.casp",
                    "begin": "<<'(\\w+)'",
                    "end": "^\\1$",
                    "beginCaptures": {
                        "0": {"name": "punctuation.definition.string.begin.casp"}
                    },
                    "endCaptures": {
                        "0": {"name": "punctuation.definition.string.end.casp"}
                    }
                },
                {
                    "name": "string.unquoted.heredoc.casp",
                    "begin": "<<(\\w+)",
                    "end": "^\\1$",
                    "beginCaptures": {
                        "0": {"name": "punctuation.definition.string.begin.casp"}
                    },
                    "endCaptures": {
                        "0": {"name": "punctuation.definition.string.end.casp"}
                    }
                },
                {
                    "name": "string.unquoted.heredoc.interpolated.casp",
                    "begin": "<<\"(\\w+)\"",
                    "end": "^\\1$",
                    "beginCaptures": {
                        "0": {"name": "punctuation.definition.string.begin.casp"}
                    },
                    "endCaptures": {
                        "0": {"name": "punctuation.definition.string.end.casp"}
                    },
                    "patterns": [
                        {"include": "#string-interpolation"},
                        {"include": "#string-var-embed"}
                    ]
                }
            ]
        },

        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.single.casp",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {"name": "constant.character.escape.casp", "match": "\\\\."}
                    ]
                },
                {
                    "name": "string.quoted.double.casp",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {"name": "constant.character.escape.casp", "match": "\\\\."},
                        {"include": "#string-interpolation"},
                        {"include": "#string-var-embed"}
                    ]
                }
            ]
        },

        "string-interpolation": {
            "name": "meta.interpolation.casp",
            "begin": "#\\{",
            "end": "\\}",
            "beginCaptures": {"0": {"name": "punctuation.section.interpolation.begin.casp"}},
            "endCaptures": {"0": {"name": "punctuation.section.interpolation.end.casp"}},
            "patterns": [{"include": "$self"}]
        },

        "string-var-embed": {
            "name": "variable.other.casp",
            "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        },

        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.casp",
                    "match": "\\b(if|elsif|elseif|else|end|while|do|return|catch|heed)\\b"
                },
                {
                    "name": "keyword.declaration.casp",
                    "match": "\\b(function|remote|class|inherits|abstract|record_class|field|accessor|helper|join)\\b"
                },
                {
                    "name": "keyword.other.casp",
                    "match": "\\b(as|yield|untrusted|self|exit|before|between|after|noloop)\\b"
                },
                {
                    "name": "keyword.operator.logical.casp",
                    "match": "\\b(and|or|not)\\b"
                }
            ]
        },

        "constants": {
            "name": "constant.language.casp",
            "match": "\\b(true|false|null)\\b"
        },

        "numbers": {
            "name": "constant.numeric.casp",
            "match": "\\b\\d+(\\.\\d+)?\\b"
        },

        "system-methods": {
            "name": "support.variable.casp",
            "match": "%[a-zA-Z_][a-zA-Z0-9_.]*"
        },

        "variables": {
            "patterns": [
                {
                    "name": "variable.other.object.casp",
                    "match": "\\$\\$[a-zA-Z_][a-zA-Z0-9_]*"
                },
                {
                    "name": "variable.other.casp",
                    "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
                }
            ]
        },

        "instance-vars": {
            "name": "variable.other.instance.casp",
            "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        },

        "functions": {
            "patterns": [
                {
                    "name": "keyword.operator.safe-nav.casp",
                    "match": "&\\."
                },
                {
                    "name": "entity.name.function.casp",
                    "match": "&[a-zA-Z_][a-zA-Z0-9_]*"
                }
            ]
        },

        "colon-strings": {
            "name": "string.other.symbol.casp",
            "match": ":[a-zA-Z_][a-zA-Z0-9_]*"
        },

        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.pipe.casp",
                    "match": "\\|&?"
                },
                {
                    "name": "keyword.operator.comparison.casp",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.casp",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arithmetic.casp",
                    "match": "[+\\-*\\/]"
                }
            ]
        }
    }
}
