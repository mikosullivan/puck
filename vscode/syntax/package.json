{
    "name": "caspian",
    "displayName": "Caspian",
    "description": "Syntax highlighting for Caspian (.casp) files",
    "version": "0.0.1",
    "publisher": "mikobase",
    "engines": {
        "vscode": "^1.0.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "caspian",
                "aliases": ["Caspian", "caspian"],
                "extensions": [".casp"]
            }
        ],
        "grammars": [
            {
                "language": "caspian",
                "scopeName": "source.casp",
                "path": "./syntaxes/caspian.tmLanguage.json"
            }
        ]
    }
}
