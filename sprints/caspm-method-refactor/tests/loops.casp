#
# name: single-line while-end with binop condition and do-while with unary-not condition
#====================================================================


# design decisions for Section 9 (loops):
#
#   Caspian is INDENT-INSENSITIVE and mostly NEWLINE-AGNOSTIC. The parser
#   handles loops the same whether the source is spread across many lines
#   with indentation or written on one line with no line breaks. Only
#   heredocs care about line structure; loops do not.
#
#   Shapes (all use the same clause-dict — body/before/between/after/noloop —
#   with all five keys always present, empty array when no statements):
#
#     while COND ... end        -> ["scope", "while_end",   COND, clauses]
#     until COND ... end        -> ["scope", "until_end",   COND, clauses]
#     begin ... while COND      -> ["scope", "begin_while", COND, clauses]
#     begin ... until COND      -> ["scope", "begin_until", COND, clauses]
#     begin ... end             -> ["scope", "begin_end",         clauses]
#
#   Disambiguation of `while COND` (opener vs do-while closer for a preceding
#   begin) is STACK-BASED: if the top-of-stack open block is a `begin`, the
#   `while COND` closes it as a do-while; otherwise it opens a new while-end.
#   Same rule for `until COND`.
#
#   Clause markers `before` / `between` / `after` / `noloop` are keywords when
#   they appear (anywhere) inside an open begin block; they switch the "current
#   clause" that subsequent statements land in. Content before any marker is
#   the `body` clause. Clause markers OUTSIDE a begin raise.
#
#   Still deferred (untested here): `.each do ... end`, `N.times do ... end`,
#   `.upto`, `.downto`, `break`, `break N`, `next`, `as $loop` bindings.
#   Section 8 (if/elsif/else/unless) and other multi-line block constructs
#   (function/closure/class) are also deferred; they'd follow the same
#   opener/closer stack pattern once wired in.

# while and until
#====================================================================
# name: while loop [ghi]
#

#--- code -----------------------------------------------------------
while $x < 10
	$x += 1
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"while_end",
		{
			"left": {
				"line": 3,
				"var": "x"
			},
			"line": 3,
			"op": "<",
			"right": {
				"line": 3,
				"value": 10
			}
		},
		{
			"body": [
				[
					"scope",
					"setvar_op",
					"+",
					"x",
					{
						"line": 2,
						"value": 1
					},
					{
						"line": 2
					}
				]
			]
		},
		{
			"line": 3
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "while_end",
		"condition": [
			{"var": "x", "fn": "<", "args": [{"primitive": 10}]}
		],
		"body": [
			{"var": "x", "fn": "+", "args": [{"primitive": 1}]},
			{
				"frame": true,
				"fn": "=",
				"syn": true,
				"args": ["x", {"rv": true}]
			}
		]
	}
]
#--------------------------------------------------------------------

