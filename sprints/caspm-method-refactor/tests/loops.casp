#
# name: until loop
#====================================================================


# deferred: nested begin-while and dangling begin-until forms not yet parsed.
# Target source — nested `begin ... while COND` where the inner begin's
# terminating `while` is on its own line (dangling), with subsequent statements
# still belonging to the outer begin:
#
#     begin
#         begin
#             $next_val = &get_next
#             &process $next_val
#         while $next_val != null
#
#         &foo
#
#         while &bar
#         end
#     end


# deferred: expression-form `begin ... while COND` (loop-at-least-once) with
# `as $block` controller binding usable as a value-atom on the RHS of setvar.
# Two things not yet in the transpiler:
#   (a) begin_while / begin_until usable as value-atoms at expression position.
#       Currently they emit statement rows only.
#   (b) `as $name` lifted to a dedicated `as: NAME` field on the atom (Option
#       B — appears only when declared).
#
# Target source:
#
#     $foo = begin as $block
#         $block.return 'my block'
#     while $bar
#
# Target full CaspJ:
#
#     [
#         ["scope", "setvar", "foo", {
#             "begin_while": {
#                 "as": "block",
#                 "condition": {"var": "bar"},
#                 "body": [
#                     [{"var": "block"}, "return", {"args": [{"value": "my block"}]}]
#                 ],
#                 "before": [],
#                 "between": [],
#                 "after": [],
#                 "noloop": []
#             }
#         }]
#     ]

#====================================================================
# name: while loop with nested begin-as-var-while [ghi]
#

#--- code -----------------------------------------------------------
while &bar
	begin as $retry_loop
		$attempt += 1
		&try_connect
	while $attempt < 5
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"while_end",
		[
			{
				"amp": "bar",
				"line": 6
			}
		],
		{
			"body": [
				[
					"scope",
					"begin_while",
					{
						"left": {
							"line": 5,
							"var": "attempt"
						},
						"line": 5,
						"op": "<",
						"right": {
							"line": 5,
							"value": 5
						}
					},
					{
						"body": [
							[
								"scope",
								"setvar_op",
								"+",
								"attempt",
								{
									"line": 3,
									"value": 1
								},
								{
									"line": 3
								}
							],
							[
								{
									"amp": "try_connect",
									"line": 4
								}
							]
						]
					},
					{
						"line": 5
					}
				]
			]
		},
		{
			"line": 6
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "while_end",
		"condition": [
			{"var": "bar", "fn": "call", "syn": true}
		],
		"body": [
			{
				"frame": true,
				"fn": "begin_while",
				"as": "retry_loop",
				"condition": [
					{"var": "attempt", "fn": "<", "args": [{"primitive": 5}]}
				],
				"body": [
					{"var": "attempt", "fn": "+", "args": [{"primitive": 1}]},
					{
						"frame": true,
						"fn": "=",
						"syn": true,
						"args": ["attempt", {"rv": true}]
					},
					{"var": "try_connect", "fn": "call", "syn": true}
				]
			}
		]
	}
]
