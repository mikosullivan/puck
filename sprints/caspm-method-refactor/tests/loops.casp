#!/usr/bin/caspian

vibecode <<EOF
{
	"doc":    "test_cases_parsing_loops",
	"role":   "sibling of parse.casp holding all loop-related transpiler fixtures — begin-while / while / until / .each-with-do-block, plus their nested and single-line variants. Split out to keep parse.casp focused on core syntax; same fixture format (boxed by `#===...` outer borders, sections `#--- code ---` / `#--- CaspJ ---` / `#--- CaspM ---` or `#--- CaspM refactor ---`), read by the same parse-extract module.",
	"status": "growing; N.times / .upto / .downto / .each control-flow deferred until the parser handles them"
}
EOF

